{
  "name": "dsh-shadow-mind",
  "version": "0.2.0",
  "description": "Read-only background and completion reviews for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-shadow-mind.git"
  },
  "homepage": "https://github.com/winterhuan/dsh-shadow-mind#readme",
  "bugs": {
    "url": "https://github.com/winterhuan/dsh-shadow-mind/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./review-policy": {
      "types": "./lib/review-policy.d.ts",
      "default": "./lib/review-policy.js"
    },
    "./commands": {
      "types": "./lib/commands.d.ts",
      "default": "./lib/commands.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.1"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:package": "publint && npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "publint": "0.3.21",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
